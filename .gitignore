/build/
/app/build/
.gradle/
.kotlin/
local.properties

# AGP's native build directory, per ABI and per variant.
.cxx/

# Native libraries are build outputs, produced by scripts/build-loaders.sh and by
# the renderer's Zig build, and consumed from here with -PskipLoaderBuild and
# -PskipNativeBuild.
/app/src/main/jniLibs/

# Signing material must never reach a repo that becomes public.
*.keystore
*.jks

# The MCP enablement the app installs into the agent's home. An asset, not
# anyone's own settings, so the usual rule against this name does not apply.
!app/src/main/assets/seed/.claude/settings.local.json
