# A CRLF shell script makes the kernel look for an interpreter named /bin/sh\r,
# and apt reports that as "Could not exec dpkg!" rather than as a line ending.
# Files here reach a device, so the ending is declared rather than left to the
# checkout.
* text=auto eol=lf

*.jar binary
*.zip binary
*.so binary
*.png binary
*.keystore binary

# An executable carries no extension to match on, so it is named in full.
app/src/main/assets/home/.claude/skills/self-adb/bin/adb-mdns binary

gradlew text eol=lf
gradlew.bat text eol=crlf
