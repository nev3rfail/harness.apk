<?xml version="1.0" encoding="utf-8"?>
<!-- As `main`, with a gradient drawable where the other channels name a colour.
     `mipmap-anydpi/ic_launcher.xml` is not overridden: a `fillColor` takes a
     colour rather than a drawable, so a gradient there means duplicating the
     glyph, and it is drawn only on API 24 and 25. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
