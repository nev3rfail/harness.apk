<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The renderer needs OpenGL ES 3.1. -->
    <uses-feature
        android:glEsVersion="0x00030001"
        android:required="true" />

    <!-- The agent, the map tiles, and the loopback socket the agent connects on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A cached app is frozen, and a frozen app stops reading the terminal the
         agent is writing to. While a tab is working the service keeps the app
         out of that state and the CPU awake; when none is, it stops. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- A project on shared storage. Without these the app writes there and sees
         only what it wrote itself, so a folder someone else filled reads as
         empty; with them, targetSdk 28 gives the whole volume as one filesystem.
         Asked for when a folder is picked, and never at launch. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Harness">
        <!-- One instance, whatever raises it. A second one would run onCreate
             again: a second Tools, a second PanelServer binding a second socket,
             and a second set of terminals resuming the conversations the first
             one is in. singleTask puts every start into this activity's own task
             and delivers it to onNewIntent, including a start from another app's
             activity that asks for no new task. On the activity rather than on
             one intent's flags, because every way into this app wants the same
             protection.

             What it costs: an intent delivered to the task that is not the
             launcher's own - a notification tap, an OPEN - finishes whatever the
             app started above this activity in its task, which is the folder and
             file pickers and the storage permission dialog, and a pick or a grant
             in progress there is lost. -->
        <!-- OPEN is how another app asks for an agent in a directory, with
             apk.harness.extra.DIRECTORY and, to reopen a conversation,
             apk.harness.extra.SESSION. A tab it opens does not mark its directory
             trusted: an intent is not the operator's tap. -->
        <!-- Every flag the attribute defines. This activity's answer to every
             configuration is the same one, reflow the layout and resize the
             terminal to the new geometry, so there is no configuration it wants
             the platform to recreate it for, and a recreation runs onDestroy,
             which stops every agent the app is running.

             screenSize is the flag the declaration turns on: an app targeting
             API 13 or higher is recreated for it even when orientation is
             handled, and every rotation changes it. mcc and mnc are here for
             minSdk 24, which is below the level where the platform stopped
             recreating for them. A device below the API level that introduced a
             flag never sets that bit, so the extra bits are inert. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|colorMode|grammaticalGender|fontScale|fontWeightAdjustment"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Harness"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="apk.harness.action.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".AgentService"
            android:exported="false" />

        <!-- A file handed to another app cannot travel as a path: an app-private
             directory is unreadable to every other uid, and a file:// URI throws
             from targetSdk 24 up. The roots are files and cache because those are
             the two the agent itself writes, so a handoff carries out only what
             the agent could already put there. The grant is read-only and lasts
             as long as the activity it started. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/handoff_paths" />
        </provider>
    </application>

</manifest>
