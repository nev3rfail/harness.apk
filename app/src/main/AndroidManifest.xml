<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The renderer needs OpenGL ES 3.1. -->
    <uses-feature
        android:glEsVersion="0x00030001"
        android:required="true" />

    <!-- The agent, the map tiles, and the loopback socket the agent connects on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A cached app is frozen, and a frozen app stops reading the terminal the
         agent is writing to. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The service's notification, and the ask an agent raises for the
         operator. Asked for at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A project on shared storage. Without it the app writes there and sees
         only what it wrote itself, so a folder someone else filled reads as
         empty; with it, the whole volume is one filesystem to the app and to
         every process the agent starts. Granted on its own settings screen,
         which the app opens when a folder outside it is picked or reopened. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- The apps a handoff can name before it fires: launchers, viewers of any
         type, a composer for mail and messages, and a dialer. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Harness">
        <!-- One instance, whatever raises it. Without this the activity is
             `standard`, and a second one runs onCreate again: a second Tools, a
             second PanelServer binding a second socket, and a second set of
             terminals over the ones already running. On the activity rather than
             on one intent's flags, because every way into this app wants the same
             protection and the ongoing service notification is one of them. -->
        <!-- Every flag the attribute defines. This activity's answer to every
             configuration is the same one, reflow the layout and resize the
             terminal to the new geometry, so there is no configuration it wants
             the platform to recreate it for, and a recreation runs onDestroy,
             which stops every agent the app is running.

             screenSize is the flag the declaration turns on: an app targeting
             API 13 or higher is recreated for it even when orientation is
             handled, and every rotation changes it. mcc and mnc are here for
             minSdk 24, which is below the level where the platform stopped
             recreating for them. A device below the API level that introduced a
             flag never sets that bit, so the extra bits are inert. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|colorMode|grammaticalGender|fontScale|fontWeightAdjustment"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Harness"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="The agent and every program it starts are child processes of this app, running tasks the user started in a terminal. They must not be stopped or paused while the app is in the background, or the task and its terminal session are lost." />
        </service>

        <!-- A file handed to another app cannot travel as a path: an app-private
             directory is unreadable to every other uid, and a file:// URI throws
             from targetSdk 24 up. The roots are files and cache because those are
             the two the agent itself writes, so a handoff carries out only what
             the agent could already put there. The grant is read-only and lasts
             as long as the activity it started. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/handoff_paths" />
        </provider>
    </application>

</manifest>
