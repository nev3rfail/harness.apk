+
+/* PRoot runs as two processes.  The waiter is the process the caller
+ * started: it traces nothing and exits with the status of vpid 1.
+ * The tracer is its child: it traces vpid 1 and every descendant,
+ * and runs until the last of them exits.  A pipe carries vpid 1's
+ * wait status from the tracer to the waiter.  */
+
+#include <stdbool.h>      /* bool, true, false, */
+#include <signal.h>       /* sigaction(2), kill(2), SIG*, */
+#include <unistd.h>       /* fork(2), pipe2(2), dup2(2), setsid(2), */
+#include <fcntl.h>        /* open(2), fcntl(2), O_*, */
+#include <dirent.h>       /* opendir(3), readdir(3), */
+#include <errno.h>        /* errno(3), */
+#include <stdlib.h>       /* exit(3), strtol(3), realloc(3), free(3), */
+#include <strings.h>      /* bzero(3), */
+#include <sys/prctl.h>    /* prctl(2), PR_SET_PDEATHSIG, */
+#include <sys/wait.h>     /* waitpid(2), W*, */
+#include <sys/resource.h> /* setrlimit(2), RLIMIT_CORE, */
+
+#include "tracee/waiter.h"
+#include "tracee/tracee.h"
+#include "cli/note.h"
+#include "attribute.h"
+
+static pid_t waiter_pid;
+static pid_t tracer_pid;
+static pid_t vpid1_pid;
+
+/* Set once waitpid(2) returns vpid 1's exit: the tracer forwards no
+ * signal from then on.  */
+static volatile sig_atomic_t vpid1_reaped;
+
+/* Set once the tracer is in a session of its own: signals take the
+ * rules that follow vpid 1's reap from then on.  */
+static volatile sig_atomic_t own_session;
+
+/* The tracer's end of the status pipe.  */
+static int status_fd = -1;
+
+/* The descriptors the tracer inherited from the caller.  */
+static int *inherited_fds;
+static size_t nb_inherited_fds;
+
+/**
+ * Return true if @signum reports a fault of this process when the
+ * kernel sends it.
+ */
+static bool is_fault(int signum)
+{
+	switch (signum) {
+	case SIGSEGV:
+	case SIGBUS:
+	case SIGILL:
+	case SIGFPE:
+	case SIGTRAP:
+	case SIGSYS:
+	case SIGABRT:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/**
+ * Deliver @signum to this process with its default action once the
+ * handler returns, since the handler blocks it until then.
+ */
+static void die_by(int signum)
+{
+	(void) signal(signum, SIG_DFL);
+	(void) kill(getpid(), signum);
+}
+
+/**
+ * Install @handler for every signal but the job-control ones, SIGKILL,
+ * SIGSTOP and, when @with_sigchld is false, SIGCHLD.
+ */
+static void install_handlers(void (*handler)(int, siginfo_t *, void *), bool with_sigchld)
+{
+	struct sigaction action;
+	int signum;
+
+	/* All signals are blocked while the handler runs.  SA_RESTART
+	 * restarts read(2) and waitpid(2) seamlessly.  */
+	bzero(&action, sizeof(action));
+	action.sa_flags = SA_SIGINFO | SA_RESTART;
+	sigfillset(&action.sa_mask);
+	action.sa_sigaction = handler;
+
+	for (signum = 1; signum <= SIGRTMAX; signum++) {
+		switch (signum) {
+		case SIGKILL:
+		case SIGSTOP:
+		case SIGCONT:
+		case SIGTSTP:
+		case SIGTTIN:
+		case SIGTTOU:
+			/* The default action is OK for these signals,
+			 * they are related to tty and job control.  */
+			continue;
+
+		case SIGCHLD:
+			if (!with_sigchld)
+				continue;
+			break;
+
+		default:
+			break;
+		}
+
+		/* sigaction(2) refuses the real-time signals the C
+		 * library reserves.  */
+		(void) sigaction(signum, &action, NULL);
+	}
+}
+
+/**
+ * Move @fd above the standard descriptors, which the tracer points at
+ * /dev/null.  This function returns the new descriptor, or -1 if an
+ * error occurred.
+ */
+static int above_stdio(int fd)
+{
+	int new_fd;
+
+	if (fd > STDERR_FILENO)
+		return fd;
+
+	new_fd = fcntl(fd, F_DUPFD_CLOEXEC, STDERR_FILENO + 1);
+	close(fd);
+	return new_fd;
+}
+
+/**
+ * Exit the way @status says a process ended: with its exit status, or
+ * by its signal with the default action.
+ */
+static void exit_as(int status) __attribute__((noreturn));
+static void exit_as(int status)
+{
+	if (WIFSIGNALED(status)) {
+		const struct rlimit no_core = { 0, 0 };
+		int signum = WTERMSIG(status);
+		sigset_t set;
+
+		/* The program has dumped its own core already.  */
+		(void) setrlimit(RLIMIT_CORE, &no_core);
+
+		(void) signal(signum, SIG_DFL);
+		sigemptyset(&set);
+		sigaddset(&set, signum);
+		(void) sigprocmask(SIG_UNBLOCK, &set, NULL);
+		(void) kill(getpid(), signum);
+
+		/* A signal whose default action does not terminate.  */
+		_exit(128 + signum);
+	}
+
+	_exit(WEXITSTATUS(status));
+}
+
+/**
+ * Handle @signum in the waiter: one sent by another process is sent to
+ * the tracer, a fault of the waiter takes its default action, and any
+ * other from the kernel, the terminal's for instance, is ignored since
+ * vpid 1 gets its own copy through the process group.
+ */
+static void waiter_handler(int signum, siginfo_t *siginfo, void *ucontext UNUSED)
+{
+	if (siginfo->si_code <= 0) {
+		if (siginfo->si_pid != waiter_pid)
+			(void) kill(tracer_pid, signum);
+		return;
+	}
+
+	if (is_fault(signum))
+		die_by(signum);
+}
+
+/**
+ * Run the waiter: exit with vpid 1's status once the tracer writes it
+ * into @fd, or with the tracer's own status when the pipe closes
+ * without one.
+ */
+static void run_waiter(int fd) __attribute__((noreturn));
+static void run_waiter(int fd)
+{
+	sigset_t set;
+	ssize_t size;
+	int status;
+
+	do
+		size = read(fd, &status, sizeof(status));
+	while (size < 0 && errno == EINTR);
+
+	if (size == sizeof(status))
+		exit_as(status);
+
+	/* The tracer died first.  Its pid can't be reused before it is
+	 * reaped, so no signal is sent to it from now on.  */
+	sigfillset(&set);
+	(void) sigprocmask(SIG_BLOCK, &set, NULL);
+
+	while (waitpid(tracer_pid, &status, 0) < 0) {
+		if (errno != EINTR)
+			_exit(EXIT_FAILURE);
+	}
+
+	exit_as(status);
+}
+
+/**
+ * Remember the descriptors the tracer inherited, but the status pipe
+ * and the listing's own.
+ */
+static void list_inherited_fds(void)
+{
+	struct dirent *entry;
+	DIR *dir;
+	int *fds;
+
+	dir = opendir("/proc/self/fd");
+	if (dir == NULL)
+		return;
+
+	while ((entry = readdir(dir)) != NULL) {
+		int fd;
+
+		if (entry->d_name[0] == '.')
+			continue;
+
+		fd = strtol(entry->d_name, NULL, 10);
+		if (fd == dirfd(dir) || fd == status_fd)
+			continue;
+
+		fds = realloc(inherited_fds, (nb_inherited_fds + 1) * sizeof(int));
+		if (fds == NULL)
+			break;
+		inherited_fds = fds;
+		inherited_fds[nb_inherited_fds++] = fd;
+	}
+
+	closedir(dir);
+}
+
+/**
+ * Fork the tracer.  This function returns in the tracer only; the
+ * waiter exits with the status of vpid 1.
+ */
+void start_waiter(void)
+{
+	int fds[2];
+	pid_t pid;
+
+	if (pipe2(fds, O_CLOEXEC) < 0) {
+		note(NULL, ERROR, SYSTEM, "pipe2()");
+		exit(EXIT_FAILURE);
+	}
+
+	fds[0] = above_stdio(fds[0]);
+	fds[1] = above_stdio(fds[1]);
+	if (fds[0] < 0 || fds[1] < 0) {
+		note(NULL, ERROR, SYSTEM, "fcntl()");
+		exit(EXIT_FAILURE);
+	}
+
+	waiter_pid = getpid();
+
+	pid = fork();
+	switch (pid) {
+	case -1:
+		note(NULL, ERROR, SYSTEM, "fork()");
+		exit(EXIT_FAILURE);
+
+	case 0: /* tracer */
+		close(fds[0]);
+		status_fd = fds[1];
+
+		/* Die with the waiter, which may have died before
+		 * this request.  */
+		(void) prctl(PR_SET_PDEATHSIG, SIGKILL);
+		if (getppid() != waiter_pid)
+			_exit(EXIT_FAILURE);
+
+		list_inherited_fds();
+		return;
+
+	default: /* waiter */
+		tracer_pid = pid;
+		close(fds[1]);
+		install_handlers(waiter_handler, true);
+		run_waiter(fds[0]);
+	}
+}
+
+/**
+ * Point the tracer's standard input and output at /dev/null, and close
+ * the other descriptors it inherited but its standard error, once
+ * @pid, vpid 1, holds them.
+ */
+void tracer_forked_vpid1(pid_t pid)
+{
+	size_t i;
+	int fd;
+
+	vpid1_pid = pid;
+
+	fd = open("/dev/null", O_RDWR);
+	if (fd >= 0) {
+		(void) dup2(fd, STDIN_FILENO);
+		(void) dup2(fd, STDOUT_FILENO);
+		if (fd > STDERR_FILENO)
+			close(fd);
+	}
+
+	for (i = 0; i < nb_inherited_fds; i++) {
+		if (inherited_fds[i] > STDERR_FILENO)
+			close(inherited_fds[i]);
+	}
+
+	free(inherited_fds);
+	inherited_fds = NULL;
+	nb_inherited_fds = 0;
+}
+
+/**
+ * Handle @signum in the tracer.
+ *
+ * While vpid 1 runs, a signal the waiter sends is sent to vpid 1, and
+ * any other is dropped: one sent to the process group reaches vpid 1
+ * directly and through the waiter already.
+ *
+ * Once vpid 1 is reaped and the tracer is in a session of its own,
+ * signals from the waiter are dropped, SIGHUP and SIGPIPE are ignored
+ * and any other signal takes its default action.
+ *
+ * A fault of the tracer kills all tracees.
+ */
+static void tracer_handler(int signum, siginfo_t *siginfo, void *ucontext UNUSED)
+{
+	if (siginfo->si_code > 0 && is_fault(signum)) {
+		/* Kill all tracees on abnormal termination of the
+		 * tracer.  This ensures no process is left
+		 * untraced.  */
+		kill_all_tracees();
+		switch (signum) {
+		case SIGSEGV:
+		case SIGILL:
+		case SIGABRT:
+		case SIGFPE:
+			note(NULL, WARNING, INTERNAL, "signal %d received", signum);
+			_exit(EXIT_FAILURE);
+
+		default:
+			die_by(signum);
+			return;
+		}
+	}
+
+	if (siginfo->si_code <= 0 && siginfo->si_pid == waiter_pid) {
+		if (!vpid1_reaped)
+			(void) kill(vpid1_pid, signum);
+		return;
+	}
+
+	if (own_session)
+		die_by(signum);
+}
+
+/**
+ * Install the tracer's signal handlers.  SIGCHLD keeps its default
+ * action, since the tracer gets one for every stop of a tracee.
+ */
+void install_tracer_handlers(void)
+{
+	install_handlers(tracer_handler, false);
+}
+
+/**
+ * Hand vpid 1's exit @status to the waiter, if @pid is vpid 1 and
+ * @status is its exit.  The tracer leaves the caller's session first,
+ * and its messages go to /dev/null from then on.
+ */
+void tracer_reaped(pid_t pid, int status)
+{
+	ssize_t size;
+	int fd;
+
+	if (pid != vpid1_pid || vpid1_reaped
+	    || !(WIFEXITED(status) || WIFSIGNALED(status)))
+		return;
+
+	vpid1_reaped = 1;
+
+	/* The waiter's exit leaves the tracer running.  */
+	(void) prctl(PR_SET_PDEATHSIG, 0);
+
+	fd = open("/dev/null", O_WRONLY);
+	if (fd >= 0) {
+		(void) dup2(fd, STDERR_FILENO);
+		if (fd != STDERR_FILENO)
+			close(fd);
+	}
+	else
+		close(STDERR_FILENO);
+
+	/* The waiter, or the process that started it, leads the
+	 * process group, so this succeeds.  Until it returns, a
+	 * signal sent to that group or from the terminal is dropped
+	 * by the rules that hold while vpid 1 runs.  */
+	(void) setsid();
+
+	(void) signal(SIGHUP, SIG_IGN);
+	(void) signal(SIGPIPE, SIG_IGN);
+	own_session = 1;
+
+	do
+		size = write(status_fd, &status, sizeof(status));
+	while (size < 0 && errno == EINTR);
+
+	close(status_fd);
+	status_fd = -1;
+}
