+			set_result_after_seccomp(tracee, -EINVAL);
+			break;
+		}
+		set_sysnum(tracee, PR_epoll_create1);
+		poke_reg(tracee, SYSARG_1, 0);
+		restart_syscall_after_seccomp(tracee);
+		break;
+
+	case PR_inotify_init:
+		set_sysnum(tracee, PR_inotify_init1);
+		poke_reg(tracee, SYSARG_1, 0);
+		restart_syscall_after_seccomp(tracee);
+		break;
+
+	case PR_signalfd:
+		set_sysnum(tracee, PR_signalfd4);
+		poke_reg(tracee, SYSARG_4, 0);
+		restart_syscall_after_seccomp(tracee);
+		break;
+
+	case PR_eventfd:
+		set_sysnum(tracee, PR_eventfd2);
+		poke_reg(tracee, SYSARG_2, 0);
+		restart_syscall_after_seccomp(tracee);
+		break;
+
+	case PR_setuid:
+	case PR_setgid:
+	case PR_setreuid:
+	case PR_setregid:
+	{
+		word_t ids[3];
+
+		ids[0] = peek_reg(tracee, CURRENT, SYSARG_1);
+		if (sysnum == PR_setuid || sysnum == PR_setgid) {
+			ids[1] = ids[0];
+			ids[2] = ids[0];
+		}
+		else {
+			ids[1] = peek_reg(tracee, CURRENT, SYSARG_2);
+			ids[2] = (word_t) -1;
+		}
+		set_result_after_seccomp(tracee,
+			check_unchanged_ids(sysnum == PR_setuid || sysnum == PR_setreuid, ids));
+		break;
+	}
+
+	case PR_setfsuid:
+		set_result_after_seccomp(tracee, geteuid());
+		break;
+
+	case PR_setfsgid:
+		set_result_after_seccomp(tracee, getegid());
+		break;
+
+	/* The other calls bionic's blocklist names; their callers
+	 * expect EPERM.  */
+	case PR_acct:
+	case PR_adjtimex:
+	case PR_chroot:
+	case PR_clock_adjtime:
+	case PR_clock_settime:
+	case PR_delete_module:
+	case PR_init_module:
+	case PR_reboot:
+	case PR_setdomainname:
+	case PR_sethostname:
+	case PR_settimeofday:
+	case PR_swapoff:
+	case PR_swapon:
+	case PR_syslog:
+		set_result_after_seccomp(tracee, -EPERM);
+		break;
+
