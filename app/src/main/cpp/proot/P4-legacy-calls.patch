+/**
+ * Return the result of a set-id call that names the ids @ids[3] (real,
+ * effective, saved; -1 names none) by the rule setresuid(2) and
+ * setresgid(2) follow here: 0 when each id it names equals the current
+ * one, otherwise -EPERM.  @uid tells user ids from group ids.
+ */
+static word_t check_unchanged_ids(bool uid, const word_t ids[3])
+{
+	uid_t current[3];
+	int status;
+	int i;
+
+	status = uid
+		? getresuid(&current[0], &current[1], &current[2])
+		: getresgid(&current[0], &current[1], &current[2]);
+	if (status < 0)
+		return -EPERM;
+
+	for (i = 0; i < 3; i++) {
+		if ((uid_t) ids[i] != (uid_t) -1 && (uid_t) ids[i] != current[i])
+			return -EPERM;
+	}
+
+	return 0;
+}
+
+/**
+ * Restore the argument registers of @tracee, the child of a fork(2)
+ * restarted as clone(2), at its first stop.  The x86_64 system-call
+ * ABI preserves them, and the child's result is 0.
+ */
+void restore_regs_after_seccomp_fork(Tracee *tracee)
+{
+	if (!tracee->restore_regs_after_seccomp_fork)
+		return;
+	tracee->restore_regs_after_seccomp_fork = false;
+
+	if (fetch_regs(tracee) < 0)
+		return;
+
+	poke_reg(tracee, SYSARG_1, peek_reg(tracee, ORIGINAL_SECCOMP_REWRITE, SYSARG_1));
+	poke_reg(tracee, SYSARG_2, peek_reg(tracee, ORIGINAL_SECCOMP_REWRITE, SYSARG_2));
+	poke_reg(tracee, SYSARG_3, peek_reg(tracee, ORIGINAL_SECCOMP_REWRITE, SYSARG_3));
+	poke_reg(tracee, SYSARG_4, peek_reg(tracee, ORIGINAL_SECCOMP_REWRITE, SYSARG_4));
+	poke_reg(tracee, SYSARG_5, peek_reg(tracee, ORIGINAL_SECCOMP_REWRITE, SYSARG_5));
+	poke_reg(tracee, SYSARG_6, peek_reg(tracee, ORIGINAL_SECCOMP_REWRITE, SYSARG_6));
+	poke_reg(tracee, SYSARG_RESULT, 0);
+	(void) push_specific_regs(tracee, false);
+}
+
+/**
+ * At the sysexit of the setitimer(2) an alarm(2) became, set the
+ * result to what alarm(2) returns for the old value: its seconds, plus
+ * one for 500000 microseconds or more, and 1 rather than 0 while time
+ * remains.
+ */
+void translate_alarm_exit(Tracee *tracee)
+{
+	struct itimerval old;
+	word_t address;
+	word_t result;
+
+	address = tracee->alarm_old_value;
+	if (address == 0)
+		return;
+	tracee->alarm_old_value = 0;
+
+	if (get_sysnum(tracee, CURRENT) != PR_setitimer
+	    || (long) peek_reg(tracee, CURRENT, SYSARG_RESULT) < 0)
+		return;
+
+	if (read_data(tracee, &old, address, sizeof(old)) < 0)
+		return;
+
+	result = old.it_value.tv_sec;
+	if ((result == 0 && old.it_value.tv_usec != 0) || old.it_value.tv_usec >= 500000)
+		result++;
+
+	poke_reg(tracee, SYSARG_RESULT, result);
+}
+
+/**
+ * Return true if Android's app policy traps the call @tracee makes.
+ * A SIGSYS for any other call comes from a filter of the program's
+ * own.
+ */
+static bool policy_traps(const Tracee *tracee)
+{
+	if (get_abi(tracee) != ABI_DEFAULT)
+		return false;
+
+	switch (peek_reg(tracee, CURRENT, SYSARG_NUM)) {
+#define TRAPPED(number) case number:
+#include "tracee/trapped-calls.h"
+#undef TRAPPED
+		return true;
+	default:
+		return false;
+	}
+}
