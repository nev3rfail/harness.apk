+		/* A SIGSYS from the program's own filter is its own
+		 * to handle.  */
+		if (!policy_traps(tracee))
+			return SIGSYS;
+
 		/* Set errno to -ENOSYS */
 		set_result_after_seccomp(tracee, -ENOSYS);
 	}
