+#if defined(PROOT_UNBUNDLE_LOADER)
+static char unbundled_loader_path[PATH_MAX];
+char proot_path[PATH_MAX];
+
+extern int main(int argc, char *const argv[]);
+
+/**
+ * Set @proot_path to the realpath of the file that holds this code,
+ * and the loader path to the file PROOT_UNBUNDLE_LOADER names in its
+ * directory.  dladdr(3) names that file whether the kernel ran it
+ * directly or a dynamic linker such as linker64 loaded it.  This
+ * function returns -1 if an error occurred, otherwise 0.
+ */
+int initialize_loader_path(void)
+{
+	char *slash;
+	Dl_info info;
+	int status;
+
+	status = dladdr((void *) main, &info);
+	if (status == 0 || info.dli_fname == NULL)
+		return -1;
+
+	if (realpath(info.dli_fname, proot_path) == NULL)
+		return -1;
+
+	/* realpath(3) returns an absolute path.  */
+	slash = strrchr(proot_path, '/');
+
+	status = snprintf(unbundled_loader_path, PATH_MAX, "%.*s/%s",
+			(int) (slash - proot_path), proot_path, PROOT_UNBUNDLE_LOADER);
+	if (status < 0 || status >= PATH_MAX)
+		return -1;
+
+	return 0;
+}
+#endif
+
