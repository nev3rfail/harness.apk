+const char *exec_bin = NULL;
+
+/**
+ * Replace @user_path, when it is /bin/x or /usr/bin/x, with
+ * @exec_bin/x if that file exists.  Nothing is replaced when
+ * @exec_bin is not set or the guest rootfs is not the host's /.
+ */
+void rewrite_exec_bin(const Tracee *tracee, char user_path[PATH_MAX])
+{
+	char path[PATH_MAX];
+	const char *root;
+	const char *rest;
+	int status;
+
+	if (exec_bin == NULL)
+		return;
+
+	root = get_root(tracee);
+	if (root == NULL || compare_paths(root, "/") != PATHS_ARE_EQUAL)
+		return;
+
+	if (strncmp(user_path, "/bin/", 5) == 0)
+		rest = user_path + 5;
+	else if (strncmp(user_path, "/usr/bin/", 9) == 0)
+		rest = user_path + 9;
+	else
+		return;
+
+	status = snprintf(path, PATH_MAX, "%s/%s", exec_bin, rest);
+	if (status < 0 || status >= PATH_MAX)
+		return;
+
+	if (access(path, F_OK) == 0)
+		strcpy(user_path, path);
+}
