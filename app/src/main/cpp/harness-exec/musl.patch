+/* The directory the file actions leave the child in, into dir: empty for the
+ * parent's own. Nonzero when that cannot be told from the parent: a chdir that
+ * does not resolve, or an fchdir to a descriptor an earlier action changes
+ * other than by opening an absolute path. */
+static int spawn_dir(const posix_spawn_file_actions_t *fa, char *dir)
+{
+	struct fdop *op, *q;
+	dir[0] = 0;
+	if (!fa || !fa->__actions) return 0;
+	for (op = fa->__actions; op->next; op = op->next);
+	for (; op; op = op->prev) {
+		if (op->cmd == FDOP_CHDIR) {
+			if (hx_chdir(dir, op->path, -1)) return 1;
+		} else if (op->cmd == FDOP_FCHDIR) {
+			/* The last earlier action on the descriptor, if any. */
+			for (q = op->next; q && !(q->fd == op->fd && (q->cmd == FDOP_OPEN
+			     || q->cmd == FDOP_DUP2 || q->cmd == FDOP_CLOSE)); q = q->next);
+			if (!q) {
+				if (hx_chdir(dir, 0, op->fd)) return 1;
+			} else if (q->cmd == FDOP_OPEN && q->path[0] == '/') {
+				if (hx_chdir(dir, q->path, -1)) return 1;
+			} else {
+				return 1;
+			}
+		}
+	}
+	return 0;
+}
