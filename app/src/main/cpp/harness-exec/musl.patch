+/* The directory the file actions leave the child in, or null for the
+ * parent's own, which a relative path is resolved against. */
+static const char *spawn_dir(const posix_spawn_file_actions_t *fa, char *dir)
+{
+	struct fdop *op;
+	dir[0] = 0;
+	if (!fa || !fa->__actions) return 0;
+	for (op = fa->__actions; op->next; op = op->next);
+	for (; op; op = op->prev)
+		if ((op->cmd == FDOP_CHDIR || op->cmd == FDOP_FCHDIR)
+		    && hx_chdir(dir, op->cmd == FDOP_CHDIR ? op->path : 0, op->fd))
+			return 0;
+	return dir[0] ? dir : 0;
+}
