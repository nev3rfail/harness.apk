+/* A link from its index alone, for an address whose link the refused link
+ * dump did not report: the name from if_indextoname, the flags from
+ * SIOCGIFFLAGS, and no hardware address. */
+static struct ifaddrs_storage *link_from_index(struct ifaddrs_ctx *ctx, unsigned int index)
+{
+	struct ifaddrs_storage *ifs;
+	struct ifreq ifr;
+	unsigned int bucket;
+	int fd;
+
+	if (!if_indextoname(index, ifr.ifr_name)) return 0;
+	ifs = calloc(1, sizeof *ifs);
+	if (!ifs) return 0;
+	ifs->index = index;
+	memcpy(ifs->name, ifr.ifr_name, IFNAMSIZ);
+	ifs->ifa.ifa_name = ifs->name;
+	fd = socket(AF_INET, SOCK_DGRAM|SOCK_CLOEXEC, 0);
+	if (fd >= 0) {
+		if (!ioctl(fd, SIOCGIFFLAGS, &ifr))
+			ifs->ifa.ifa_flags = (unsigned short)ifr.ifr_flags;
+		__syscall(SYS_close, fd);
+	}
+	bucket = index % IFADDRS_HASH_SIZE;
+	ifs->hash_next = ctx->hash[bucket];
+	ctx->hash[bucket] = ifs;
+	if (!ctx->first) ctx->first = &ifs->ifa;
+	if (ctx->last) ctx->last->ifa_next = &ifs->ifa;
+	ctx->last = &ifs->ifa;
+	return ifs;
+}
+
 static int netlink_msg_to_ifaddr(void *pctx, struct nlmsghdr *h)
 {
 	struct ifaddrs_ctx *ctx = pctx;
