+/* Routes the call from the child, which by now stands in the directory the
+ * file actions left it in, and issues it. A function of its own so that the
+ * router's state is on the stack only while this runs: child() keeps the small
+ * frame that the stack of a call routed in the parent is sized for. */
+static __attribute__((__noinline__)) int route_in_child(const struct args *args)
+{
+	struct hx_exec hx;
+	int e = args->search
+		? hx_route_search(args->path, args->search, args->argv, args->envp, 0, &hx)
+		: hx_route(args->path, args->argv, args->envp, 0, &hx);
+	if (e) return -e;
+	e = __syscall(SYS_execve, hx.path, hx.argv, hx.envp);
+	hx_release(&hx);
+	return e;
+}
