#!/bin/sh
# Stand in for dpkg so that Termux .deb archives install into this app's prefix.
#
# A Termux .deb is rooted at the absolute Termux path -- its payload is
# ./data/data/com.termux/files/usr/... -- and its binaries carry that path in
# DT_RUNPATH, in shebangs and in compiled-in defaults. Installed unchanged into
# another app it writes nothing and resolves nothing.
#
# So every archive is rewritten on the way past: the payload is moved to this
# app's data directory, and librelocate applies the substitutions the bootstrap
# was relocated with to the contents of every file, every symlink target and
# every x86_64 TLS segment in it. File contents are substituted byte for byte,
# because a shorter string in a stripped binary's .rodata cannot be shifted and
# a longer one cannot be represented at all. The prefix as a whole is what has to fit, not the app
# data directory: a directory one byte longer than Termux's is paid for by the
# rootfs directory below it being one byte shorter.
#
# Install it as apt's dpkg, which is the single point every apt entry point
# goes through, so nothing has to be remembered at a call site:
#
#   cp repack-deb.sh $PREFIX/libexec/repack-deb
#   chmod 755 $PREFIX/libexec/repack-deb
#   echo 'Dir::Bin::dpkg "'$PREFIX'/libexec/repack-deb";' \
#     > $PREFIX/etc/apt/apt.conf.d/99-repack
#
# It lives outside $PREFIX/bin on purpose: nothing owns $PREFIX/libexec, so an
# upgrade of the dpkg package cannot overwrite it. A `dpkg -i` typed by hand
# still bypasses it; run this instead.
set -e

OLD_APPDIR=/data/data/com.termux
OLD_ROOTFS=$OLD_APPDIR/files
OLD_CACHE=$OLD_APPDIR/cache

# Where this app's prefix is, taken from where this script was invoked from,
# so the script itself carries no path.
self=$0
case $self in */*) : ;; *) self=$(command -v "$self") ;; esac
PREFIX=${PREFIX:-$(cd "$(dirname "$self")/.." && pwd)}
export PATH=$PREFIX/bin:$PATH
export LC_ALL=C

rootfs=${PREFIX%/*}
appdir=${rootfs%/*}

if [ ${#rootfs} -gt ${#OLD_ROOTFS} ]; then
  echo "repack-deb: '$rootfs' is ${#rootfs} bytes; '$OLD_ROOTFS' is" \
    "${#OLD_ROOTFS}." >&2
  echo "repack-deb: a longer path cannot replace a shorter one in place." >&2
  exit 1
fi

# The cache directory is this app's to name, so it is named to fit.
cache_name=$(echo cache | cut -c1-$(( ${#OLD_CACHE} - ${#appdir} - 1 )))

# The packaged relocator, reached through the rootfs's link to the native
# library directory, so no PATH decides which one runs.
relocate=$rootfs/applib/librelocate.so

real=$PREFIX/bin/dpkg.real
[ -x "$real" ] || real=$PREFIX/bin/dpkg

lock=$PREFIX/tmp/.repack-deb-lock
lock_fd=
work=
trap 'rm -rf "$work"' EXIT INT TERM

# Runs in this shell, before the first archive is repacked, and holds the lock
# until the script exits. The descriptor is the highest of 9 down to 3 that is
# not already open: apt passes its own, such as --status-fd, and a redirection
# in this shell takes one digit.
take_lock() {
  [ -z "$lock_fd" ] || return 0
  fd=9
  while [ $fd -ge 3 ] && [ -L /proc/$$/fd/$fd ]; do fd=$((fd - 1)); done
  if [ $fd -lt 3 ]; then
    echo "repack-deb: no descriptor from 3 to 9 is free for the lock" >&2
    exit 1
  fi
  mkdir -p "$PREFIX/tmp"
  eval "exec $fd>>\"\$lock\""
  "$relocate" --flock $fd
  lock_fd=$fd

  # Under the lock, every other work directory belongs to a run that ended.
  rm -rf "$PREFIX"/tmp/repack-deb.*
  work=$(mktemp -d "$PREFIX/tmp/repack-deb.XXXXXX")
}

repack() {
  in=$1
  out=$work/$(basename "$in")
  d=$work/u
  rm -rf "$d"
  dpkg-deb -R "$in" "$d"

  if [ -d "$d$OLD_ROOTFS" ]; then
    mkdir -p "$(dirname "$d$rootfs")"
    mv "$d$OLD_ROOTFS" "$d$rootfs"
    rmdir -p "$(dirname "$d$OLD_ROOTFS")" 2>/dev/null || true
  fi

  "$relocate" --content --links --tls "$d" \
    "$OLD_ROOTFS" "$rootfs" \
    "$OLD_CACHE" "$appdir/$cache_name" \
    "$OLD_APPDIR" "$appdir" > /dev/null

  # Maintainer scripts arrive 0700 and dpkg-deb refuses anything outside
  # 0555..0775.
  for s in preinst postinst prerm postrm config triggers; do
    [ -f "$d/DEBIAN/$s" ] && chmod 755 "$d/DEBIAN/$s"
  done

  # A package may declare a conffile it does not ship -- cups 2.4.19 names
  # var/service/cupsd/log/down and carries no such file. `dpkg-deb -R` accepts
  # that and `dpkg-deb -b` refuses it, so such a package can be unpacked and
  # never rebuilt, which is the one thing this script has to do to every
  # archive. The entry is dropped rather than the file invented: a conffile
  # protects a file from being overwritten on upgrade, and there is no file.
  # A dangling symlink is shipped, so -L keeps what -e alone would drop.
  if [ -f "$d/DEBIAN/conffiles" ]; then
    while IFS= read -r conffile; do
      [ -n "$conffile" ] || continue
      if [ -e "$d$conffile" ] || [ -L "$d$conffile" ]; then
        printf '%s\n' "$conffile"
      fi
    done < "$d/DEBIAN/conffiles" > "$d/DEBIAN/conffiles.kept"
    mv "$d/DEBIAN/conffiles.kept" "$d/DEBIAN/conffiles"
  fi

  # The payload changed, so the recorded checksums have to change with it or
  # `dpkg --verify` reports every file as corrupt.
  if [ -f "$d/DEBIAN/md5sums" ]; then
    ( cd "$d" && find . -path ./DEBIAN -prune -o -type f -print \
        | sed 's|^\./||' | sort | xargs -r md5sum ) > "$d/DEBIAN/md5sums"
  fi

  # The fastest gzip: the archive is unpacked again seconds later by the dpkg
  # this script runs, and recompressing it with the repository's xz settings
  # costs more than everything else here put together.
  dpkg-deb -b -Zgzip -z1 "$d" "$out" >/dev/null
  echo "$out"
}

repack_dir() {
  out=$work/recursive
  mkdir -p "$out"
  # No `-type f`: apt fills that directory with links into its archive cache.
  for deb in $(find "$1" -name '*.deb' | sort); do
    mv "$(repack "$deb")" "$out/"
  done
  echo "$out"
}

# Rewrite every argument that names an archive, and the directory that follows
# `--recursive`, which is how apt actually hands dpkg a set of packages. Pass
# everything else through untouched: most of what apt calls dpkg for --
# `--print-foreign-architectures`, `--assert-multi-arch`, `--status-fd` --
# names no archive at all, and takes no lock.
n=$#
i=0
recursive=
while [ $i -lt $n ]; do
  a=$1; shift
  if [ -n "$recursive" ] && [ -d "$a" ]; then
    take_lock
    a=$(repack_dir "$a")
    recursive=
  else
    case $a in
      --recursive|-R) recursive=1 ;;
      *.deb) if [ -f "$a" ]; then take_lock; a=$(repack "$a"); fi ;;
    esac
  fi
  set -- "$@" "$a"
  i=$((i + 1))
done

# Run rather than exec, so the EXIT trap removes the work directory, and with the
# lock closed, so neither dpkg nor a daemon a maintainer script starts holds it
# past this script.
if [ -n "$lock_fd" ]; then
  eval '"$real" "$@"' "$lock_fd>&-"
else
  "$real" "$@"
fi
